# ============================================================
# java-backend 环境变量示例
#
# 说明：Spring Boot 不会自动读取 .env 文件，本文件仅作为「需要注入哪些变量」的清单。
# 使用方式（任选其一）：
#   1. 启动前在 shell 中 export / set（推荐，本地开发）
#   2. 用 docker compose / systemd / 云平台的环境变量配置
#   3. 本地临时调试：命令行参数 --pethome.jwt.secret=xxx
#
# 未列出的变量均有 dev 默认值（见 application-dev.yaml），生产 profile
# （SPRING_PROFILES_ACTIVE=prod）必须显式提供标注「生产必填」的变量，否则启动自检会失败。
# ============================================================

# ---------------- 运行环境 ----------------
# dev（默认，含演示数据）/ prod（生产，安全自检更严格）
SPRING_PROFILES_ACTIVE=dev
# 服务端口，默认 8080
SERVER_PORT=8080

# ---------------- MySQL ----------------
# 生产必填（application-prod.yaml 无默认值）
PETHOME_MYSQL_USERNAME=root
PETHOME_MYSQL_PASSWORD=change-me
# 仅 prod 使用，形如 jdbc:mysql://127.0.0.1:3306/pet_home?serverTimezone=Asia/Shanghai
PETHOME_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/pet_home?serverTimezone=Asia/Shanghai

# ---------------- Redis ----------------
PETHOME_REDIS_HOST=127.0.0.1
PETHOME_REDIS_PORT=6379
PETHOME_REDIS_PASSWORD=change-me

# ---------------- RabbitMQ ----------------
PETHOME_RABBITMQ_HOST=127.0.0.1
PETHOME_RABBITMQ_PORT=5672
PETHOME_RABBITMQ_USERNAME=guest
PETHOME_RABBITMQ_PASSWORD=change-me
PETHOME_RABBITMQ_VHOST=/

# ---------------- JWT ----------------
# 生产必填，长度 ≥ 32 字节
PETHOME_JWT_SECRET=please-change-to-a-random-secret-at-least-32-bytes
PETHOME_JWT_EXPIRE_SECONDS=86400

# ---------------- RAG 知识库服务 ----------------
PETHOME_RAG_ENABLED=true
PETHOME_RAG_BASE_URL=http://127.0.0.1:8000
# 需与 rag-service 的 RAG_API_KEY 一致
PETHOME_RAG_API_KEY=change-me

# ---------------- 支付 ----------------
# mock / wechat / alipay
PETHOME_PAYMENT_CHANNEL=mock
# 生产默认禁止模拟支付；未接入真实渠道时才临时开启
PETHOME_PAYMENT_ALLOW_MOCK=false
# 回调验签密钥（mock 渠道使用 HMAC-SHA256(原始报文, secret)）
PETHOME_PAYMENT_CALLBACK_SECRET=change-me
PETHOME_PAYMENT_PREPAY_EXPIRE_MINUTES=30

# ---------------- 上传 ----------------
# local（本地磁盘）/ oss（对象存储，未接入时启动失败，不会静默降级）
PETHOME_UPLOAD_STORAGE_TYPE=local
PETHOME_UPLOAD_BASE_DIR=./upload

# ---------------- 认证与安全 ----------------
# 仅本地开发允许直传 openid 登录；生产固定 false
PETHOME_AUTH_ALLOW_OPENID_DIRECT_LOGIN=false
PETHOME_AUTH_MAX_FAIL_COUNT=5
PETHOME_AUTH_LOCK_MINUTES=15
PETHOME_AUTH_RATE_LIMIT_PER_MINUTE=20
# 生产必须为 false（true 会跳过生产安全自检）
PETHOME_ALLOW_INSECURE_DEV_CONFIG=false
# 允许跨域的来源，逗号分隔；* 仅限开发
PETHOME_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------- 微信小程序 ----------------
PETHOME_WECHAT_APPID=
PETHOME_WECHAT_SECRET=
