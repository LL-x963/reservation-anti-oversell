# ============================================================
# RAG 服务配置示例：复制为 .env 后按需修改
# 环境变量优先级高于 .env 文件；变量名与 settings.py 字段名一一对应（大写）
# ============================================================

# ---------------- 服务 ----------------
APP_NAME=pet-home-rag-service
LOG_LEVEL=INFO

# ---------------- 鉴权（请求头 X-API-Key） ----------------
RAG_API_KEY=pethome-rag-key

# ---------------- Ollama ----------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:1.5b
LLM_TEMPERATURE=0.1

# ---------------- 向量模型 ----------------
# huggingface：本地推理 bge-small-zh（需 torch）；ollama：走 Ollama（需先 ollama pull）
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DEVICE=cpu

# ---------------- Chroma ----------------
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=knowledge_chunks

# ---------------- 检索与切分 ----------------
RETRIEVE_TOP_K=2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------------- 对话历史 ----------------
HISTORY_MAX_ROUNDS=3

# ---------------- HuggingFace 镜像（国内下载模型加速） ----------------
# HF_ENDPOINT=https://hf-mirror.com
