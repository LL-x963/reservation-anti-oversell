# ============================================================
# RAG 服务配置示例：复制为 .env 后按需修改
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# 环境变量优先级高于 .env 文件；变量名与 app/config/settings.py 字段名一一对应（大写）
# 注意：.env 已被 .gitignore 忽略，请勿提交任何真实密钥
# ============================================================

# ---------------- 服务 ----------------
APP_NAME=pet-home-rag-service
APP_VERSION=1.1.0
LOG_LEVEL=INFO
# 监听端口（uvicorn / python main.py 均使用该值）
SERVER_PORT=8000

# ---------------- 鉴权（请求头 X-API-Key） ----------------
# 示例值仅用于本地联调，必须与 java-backend 的 PETHOME_RAG_API_KEY 一致
RAG_API_KEY=pethome-rag-key

# ---------------- Ollama（对话模型 + 向量模型） ----------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:7b
LLM_TEMPERATURE=0.1
# 是否保留推理模型的思考输出：false（默认）不把 think 内容混入答案
LLM_REASONING=false
# 单次生成最大 token 数：-1 表示不限制
LLM_NUM_PREDICT=-1

# ---------------- 向量模型 ----------------
# ollama（默认，推荐）：向量由 Ollama 计算，无需 torch；需先执行 ollama pull bge-m3
# huggingface（可选）：本地推理 bge-small-zh，需额外安装 sentence-transformers（含 torch，约 2-3GB）
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3
HF_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ---------------- Chroma ----------------
# 相对路径，索引库不入库，可随时通过 /api/knowledge/reindex 重建
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=knowledge_chunks
# 重建索引时的分批入库条数
INDEX_BATCH_SIZE=100

# ---------------- 检索与切分 ----------------
RETRIEVE_TOP_K=2
# 相关性阈值（0~1，0 表示关闭）：命中片段相似度低于该值时视为无可用知识。
# 默认 0.5（bge-m3 实测：相关提问 0.73~0.81、无关提问 0.30~0.38），用于拦住越界提问
RETRIEVE_SCORE_THRESHOLD=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------------- 对话历史 ----------------
HISTORY_MAX_ROUNDS=3

# ---------------- 固定话术 ----------------
# 答案末尾固定拼接的免责声明（建议保留医疗提示）
DISCLAIMER=以上内容仅供科普参考，若宠物出现不适或症状严重，请及时前往宠物医院就医。
# 未检索到可用知识片段时的兜底回答（避免模型凭空作答）
NO_CONTEXT_ANSWER=知识库中暂未收录相关内容，建议咨询专业宠物医生获取帮助。

# ---------------- HuggingFace 镜像（仅在 EMBEDDING_PROVIDER=huggingface 时需要） ----------------
# HF_ENDPOINT=https://hf-mirror.com

# ---------------- Ollama 模型目录（自定义过安装位置时，启动 ollama 服务需一并设置） ----------------
# OLLAMA_MODELS=/path/to/ollama/models
