# ============================================================
# 宠享到家 - 全栈仓库忽略规则
# 覆盖：Python(RAG) / Java(后端) / Node(前端) / 构建产物 / 运行数据 / IDE
# ============================================================

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# ---------------- Java / Maven ----------------
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# ---------------- Node / 前端 ----------------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------- 运行数据 / 上传文件 ----------------
# Chroma 向量库持久化目录（重建索引即可恢复，不入库）
chroma_db/
# 后端本地上传目录：只保留目录占位文件，实际图片不入库
upload/*
!upload/.gitkeep
uploads/*
!uploads/.gitkeep
data/*
!data/.gitkeep
*.sqlite3
*.rdb
*.dump

# ---------------- 日志 ----------------
logs/
log/
*.log

# ---------------- 环境变量（含密钥，禁止入库） ----------------
.env
.env.*
!.env.example

# ---------------- IDE / 编辑器 ----------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo

# ---------------- 操作系统 ----------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------- 临时文件 ----------------
*.tmp
*.temp
*.bak
*.orig
